<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Swappy.Configs</RootNamespace>
        <AssemblyName>Swappy.Configs</AssemblyName>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Northwood.LabAPI" Version="1.1.7" />
        <PackageReference Include="Octokit" Version="14.0.0" />
        <PackageReference Include="BepInEx.AssemblyPublicizer.MSBuild" Version="0.4.2" PrivateAssets="all" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="Assembly-CSharp" HintPath="$(SL_REFERENCES)\Assembly-CSharp.dll" Publicize="true" />
        <Reference Include="CommandSystem.Core">
            <HintPath>$(SL_REFERENCES)\CommandSystem.Core.dll</HintPath>
        </Reference>
        <Reference Include="NorthwoodLib">
            <HintPath>$(SL_REFERENCES)\NorthwoodLib.dll</HintPath>
        </Reference>
        <Reference Include="netstandard">
            <HintPath>$(SL_REFERENCES)\netstandard.dll</HintPath>
        </Reference>
        <Reference Include="System.Net.Http">
            <HintPath>$(SL_REFERENCES)\System.Net.Http.dll</HintPath>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(SL_REFERENCES)\UnityEngine.CoreModule.dll</HintPath>
        </Reference>
    </ItemGroup>
</Project>
